{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "habitta-api",
  "main": "src/worker-entry.ts",
  "compatibility_date": "2026-07-26",
  "vars": {
    "APP_ENV": "development",
    "SUPABASE_URL": "http://127.0.0.1:54321",
    "NOTIFICATIONS_EMAIL_MODE": "disabled",
    "NOTIFICATIONS_EMAIL_PROVIDER": "zeptomail",
    "BILLING_PROVIDER": "mock",
  },
  "r2_buckets": [{ "binding": "PAYMENT_PROOFS", "bucket_name": "habitta-payment-proofs-local" }],
  "queues": {
    "producers": [
      { "binding": "NOTIFICATION_QUEUE", "queue": "habitta-notifications-local" },
      { "binding": "INTEGRATION_QUEUE", "queue": "habitta-integrations-local" },
    ],
    "consumers": [
      {
        "queue": "habitta-notifications-local",
        "max_batch_size": 10,
        "max_retries": 5,
        "max_concurrency": 1,
        "dead_letter_queue": "habitta-notifications-dlq-local",
      },
      {
        "queue": "habitta-integrations-local",
        "max_batch_size": 10,
        "max_retries": 5,
        "max_concurrency": 1,
        "dead_letter_queue": "habitta-integrations-dlq-local",
      },
    ],
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "ratelimits": [
    {
      "name": "PROOF_UPLOAD_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 },
    },
    { "name": "INVITATION_LIMIT", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    { "name": "REQUEST_LIMIT", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } },
    { "name": "TELEMETRY_LIMIT", "namespace_id": "1004", "simple": { "limit": 20, "period": 60 } },
    {
      "name": "ORGANIZATION_SIGNUP_LIMIT",
      "namespace_id": "1005",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      "name": "FINANCIAL_WRITE_LIMIT",
      "namespace_id": "1006",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
  "observability": { "enabled": true },
  "env": {
    "dev": {
      "name": "habitta-api-dev",
      "vars": {
        "APP_ENV": "development",
        "NOTIFICATIONS_EMAIL_MODE": "disabled",
        "NOTIFICATIONS_EMAIL_PROVIDER": "zeptomail",
        "NOTIFICATIONS_FROM_EMAIL": "notifications@mihabitta.com",
        "NOTIFICATIONS_FROM_NAME": "Habitta",
        "APP_BASE_URL": "https://development.habitta-web-dev.pages.dev",
        "BILLING_PROVIDER": "mock",
      },
      "secrets": {
        "required": ["SUPABASE_ANON_KEY", "SUPABASE_SERVICE_ROLE_KEY", "ZEPTOMAIL_SEND_TOKEN"],
      },
      "r2_buckets": [{ "binding": "PAYMENT_PROOFS", "bucket_name": "habitta-payment-proofs-dev" }],
      "queues": {
        "producers": [
          { "binding": "NOTIFICATION_QUEUE", "queue": "habitta-notifications-dev" },
          { "binding": "INTEGRATION_QUEUE", "queue": "habitta-integrations-dev" },
        ],
        "consumers": [
          {
            "queue": "habitta-notifications-dev",
            "max_batch_size": 10,
            "max_retries": 5,
            "max_concurrency": 1,
            "dead_letter_queue": "habitta-notifications-dlq-dev",
          },
          {
            "queue": "habitta-integrations-dev",
            "max_batch_size": 10,
            "max_retries": 5,
            "max_concurrency": 1,
            "dead_letter_queue": "habitta-integrations-dlq-dev",
          },
        ],
      },
      "triggers": { "crons": [] },
      "ratelimits": [
        {
          "name": "PROOF_UPLOAD_LIMIT",
          "namespace_id": "2001",
          "simple": { "limit": 20, "period": 60 },
        },
        {
          "name": "INVITATION_LIMIT",
          "namespace_id": "2002",
          "simple": { "limit": 10, "period": 60 },
        },
        {
          "name": "REQUEST_LIMIT",
          "namespace_id": "2003",
          "simple": { "limit": 30, "period": 60 },
        },
        {
          "name": "TELEMETRY_LIMIT",
          "namespace_id": "2004",
          "simple": { "limit": 20, "period": 60 },
        },
        {
          "name": "ORGANIZATION_SIGNUP_LIMIT",
          "namespace_id": "2005",
          "simple": { "limit": 5, "period": 60 },
        },
        {
          "name": "FINANCIAL_WRITE_LIMIT",
          "namespace_id": "2006",
          "simple": { "limit": 30, "period": 60 },
        },
      ],
    },
    "prod": {
      "name": "habitta-api-prod",
      "vars": {
        "APP_ENV": "production",
        "NOTIFICATIONS_EMAIL_MODE": "live",
        "NOTIFICATIONS_EMAIL_PROVIDER": "zeptomail",
        "NOTIFICATIONS_FROM_EMAIL": "notifications@mihabitta.com",
        "NOTIFICATIONS_FROM_NAME": "Habitta",
        "APP_BASE_URL": "https://app.mihabitta.com",
        "CORS_ALLOWED_ORIGINS": "https://app.mihabitta.com",
        "BILLING_PROVIDER": "stripe",
      },
      "secrets": {
        "required": [
          "SUPABASE_ANON_KEY",
          "SUPABASE_SERVICE_ROLE_KEY",
          "STRIPE_SECRET_KEY",
          "STRIPE_WEBHOOK_SECRET",
        ],
      },
      "r2_buckets": [{ "binding": "PAYMENT_PROOFS", "bucket_name": "habitta-payment-proofs-prod" }],
      "queues": {
        "producers": [
          { "binding": "NOTIFICATION_QUEUE", "queue": "habitta-notifications-prod" },
          { "binding": "INTEGRATION_QUEUE", "queue": "habitta-integrations-prod" },
        ],
        "consumers": [
          {
            "queue": "habitta-notifications-prod",
            "max_batch_size": 10,
            "max_retries": 5,
            "max_concurrency": 1,
            "dead_letter_queue": "habitta-notifications-dlq-prod",
          },
          {
            "queue": "habitta-integrations-prod",
            "max_batch_size": 10,
            "max_retries": 5,
            "max_concurrency": 1,
            "dead_letter_queue": "habitta-integrations-dlq-prod",
          },
        ],
      },
      "ratelimits": [
        {
          "name": "PROOF_UPLOAD_LIMIT",
          "namespace_id": "3001",
          "simple": { "limit": 20, "period": 60 },
        },
        {
          "name": "INVITATION_LIMIT",
          "namespace_id": "3002",
          "simple": { "limit": 10, "period": 60 },
        },
        {
          "name": "REQUEST_LIMIT",
          "namespace_id": "3003",
          "simple": { "limit": 30, "period": 60 },
        },
        {
          "name": "TELEMETRY_LIMIT",
          "namespace_id": "3004",
          "simple": { "limit": 20, "period": 60 },
        },
        {
          "name": "ORGANIZATION_SIGNUP_LIMIT",
          "namespace_id": "3005",
          "simple": { "limit": 5, "period": 60 },
        },
        {
          "name": "FINANCIAL_WRITE_LIMIT",
          "namespace_id": "3006",
          "simple": { "limit": 30, "period": 60 },
        },
      ],
      "triggers": { "crons": ["*/5 * * * *"] },
    },
  },
}
