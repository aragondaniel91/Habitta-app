{
  "name": "habitta",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "build": "pnpm notifications:config:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "notifications:config:check": "node scripts/cloudflare/validate-notifications-config.mjs",
    "notifications:dev": "pnpm --filter @habitta/api exec wrangler dev --env dev --local",
    "notifications:smoke": "node scripts/cloudflare/notifications-smoke.mjs",
    "notifications:infra:plan": "node scripts/cloudflare/provision-notifications-dev.mjs",
    "notifications:infra:apply": "node scripts/cloudflare/provision-notifications-dev.mjs --apply",
    "notifications:dlq:diagnose": "node scripts/cloudflare/notifications-dlq-diagnostics.mjs",
    "release:dev:validate": "node scripts/release/validate-development-release.mjs",
    "release:dev:resources:plan": "node scripts/release/provision-development-resources.mjs",
    "release:dev:resources:apply": "node scripts/release/provision-development-resources.mjs --apply",
    "release:dev:smoke": "node scripts/release/development-smoke.mjs",
    "release:dev:verify-web": "node scripts/release/verify-web-bundle-secrets.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/node": "^24.0.10",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.5",
    "prettier": "^3.6.2",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.36.0",
    "vitest": "^3.2.4"
  }
}
